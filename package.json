{
  "name": "munim-ffmpeg-root",
  "private": true,
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "build": "npm --workspace munim-ffmpeg run build",
    "codegen": "npm --workspace munim-ffmpeg run codegen",
    "typecheck": "npm --workspace munim-ffmpeg run typecheck",
    "typecheck:example": "tsc --noEmit -p example/tsconfig.json",
    "check": "npm run codegen && npm run typecheck && npm run typecheck:example && npm run build && npm run pack:dry-run",
    "pack:dry-run": "npm --workspace munim-ffmpeg pack --dry-run",
    "example:start": "npm --workspace example run start",
    "example:ios": "npm --workspace example run ios",
    "example:android": "npm --workspace example run android"
  }
}
