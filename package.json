{
  "name": "munim-ffmpeg",
  "version": "0.4.2",
  "description": "Fast FFmpeg and FFprobe for Expo and React Native, powered by Nitro Modules",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "bin": {
    "munim-ffmpeg-fetch-binaries": "scripts/fetch-binaries.mjs"
  },
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/src/main/java",
    "cpp",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "nitro.json",
    "*.podspec",
    "README.md",
    "LICENSE",
    "android/src/main/cpp",
    "android/src/main/AndroidManifest.xml",
    "scripts/fetch-binaries.mjs",
    "scripts/binaries.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:example": "tsc --noEmit -p example/tsconfig.json",
    "clean": "rm -rf lib android/build example/ios example/android",
    "lint": "eslint .",
    "codegen": "nitrogen --logLevel=\"debug\"",
    "specs": "npm run codegen",
    "build": "npm run typecheck && tsc",
    "prepack": "npm run build",
    "check": "npm run codegen && npm run typecheck && npm run typecheck:example && npm run build && npm pack --dry-run",
    "example:start": "npm --workspace example run start",
    "example:ios": "npm --workspace example run ios",
    "example:android": "npm --workspace example run android",
    "release:local": "node scripts/release-local.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,md}\"",
    "postinstall": "node scripts/fetch-binaries.mjs",
    "binaries:build": "scripts/ffmpeg/fetch-source.sh && scripts/ffmpeg/build-all.sh",
    "binaries:package": "scripts/ffmpeg/package.sh"
  },
  "keywords": [
    "react-native",
    "expo",
    "ffmpeg",
    "ffprobe",
    "video",
    "audio",
    "ios",
    "android",
    "typescript",
    "nitro",
    "nitro-modules",
    "react-native-ffmpeg",
    "expo-plugin",
    "video-processing",
    "audio-processing",
    "media-processing",
    "transcoding",
    "munim-technologies"
  ],
  "workspaces": [
    "example"
  ],
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munimtechnologies/munim-ffmpeg.git"
  },
  "author": "sheehanmunim <support@munimtech.com> (https://github.com/sheehanmunim)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/munimtechnologies/munim-ffmpeg/issues"
  },
  "homepage": "https://github.com/munimtechnologies/munim-ffmpeg#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "expo": {
    "name": "munim-ffmpeg",
    "platforms": [
      "ios",
      "android"
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/react": "^19.2.15",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.11.0",
    "nitrogen": "0.36.5",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-nitro-modules": "^0.36.5",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.36.5 <1"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  }
}
