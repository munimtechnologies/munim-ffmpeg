{
  "name": "munim-ffmpeg",
  "version": "0.1.1",
  "description": "Fast FFmpeg and FFprobe for Expo and React Native, powered by Nitro Modules",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "cpp",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "scripts",
    "app.plugin.js",
    "nitro.json",
    "*.podspec",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf android/build node_modules/**/android/build lib",
    "lint": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "lint-ci": "eslint \"**/*.{js,ts,tsx}\" -f @jamesacarr/github-actions --max-warnings 0",
    "build": "npm run typecheck && tsc",
    "prepack": "npm run build",
    "typescript": "tsc",
    "codegen": "nitrogen --logLevel=\"debug\"",
    "specs": "npm run codegen"
  },
  "keywords": [
    "react-native",
    "expo",
    "ffmpeg",
    "ffprobe",
    "video",
    "audio",
    "ios",
    "android",
    "typescript",
    "nitro",
    "nitro-modules",
    "react-native-ffmpeg",
    "expo-plugin",
    "video-processing",
    "audio-processing",
    "media-processing",
    "transcoding",
    "munim-technologies"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munimtechnologies/munim-ffmpeg.git"
  },
  "author": "sheehanmunim <support@munimtech.com> (https://github.com/sheehanmunim)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/munimtechnologies/munim-ffmpeg/issues"
  },
  "homepage": "https://github.com/munimtechnologies/munim-ffmpeg#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "expo": {
    "name": "munim-ffmpeg",
    "platforms": [
      "ios",
      "android"
    ]
  },
  "devDependencies": {
    "@react-native/eslint-config": "0.85.3",
    "@types/react": "^19.2.15",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "nitrogen": "0.36.5",
    "prettier": "^3.8.3",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-nitro-modules": "^0.36.5",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.36.5 <1"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "warn",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  }
}
